javascript:(function(){let b=[],i=0,d=200;function chk(a){return fetch(a.href,{method:"HEAD",redirect:"manual"}).then(r=>{let s=r.status,t=r.type;if(t==="opaqueredirect"||s>=300&&s<400){a.style.border="3px solid orange";a.title="Redirect ("+s+")"}else if(s>=400){a.style.border="3px solid red";a.title="Broken link ("+s+")";b.push(a.href)}else{a.style.border="3px solid green"}}).catch(()=>{a.style.border="3px solid red";a.title="Broken link";b.push(a.href)})}let links=[...document.querySelectorAll("a")].filter(a=>{try{return new URL(a.href).hostname===location.hostname}catch(e){return!1}});(function run(){if(i>=links.length){alert((b.length?b.length+" broken links found!":"No broken links found!"));console.log("Broken links:",b);return;}chk(links[i++]).finally(()=>setTimeout(run,d));})();})();
